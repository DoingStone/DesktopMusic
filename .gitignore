# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/

# Published binaries are distributed as release assets, not committed:
# a self-contained build is ~25 MB and would bloat the repository.
publish/

# Locally generated verification screenshots and capture dumps
artifacts/

# Tooling caches
*.binlog
*.log
TestResults/

# Third-party typefaces are NOT redistributed with this repository: a typeface carries its
# own licence, and the subset this option was developed against came out of another
# application's install. Drop your own file in to enable the built-in font - see
# src/TaskbarLyrics.App/Fonts/README.md. The build works fine without it.
src/TaskbarLyrics.App/Fonts/*.ttf
src/TaskbarLyrics.App/Fonts/*.otf
src/TaskbarLyrics.App/Fonts/*.woff2
