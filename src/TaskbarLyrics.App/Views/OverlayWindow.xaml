<Window x:Class="TaskbarLyrics.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TaskbarLyrics.App.Controls"
        Title="TaskbarLyrics Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Focusable="False"
        IsTabStop="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Progress bar colours, configurable alongside the rest of the palette. -->
        <SolidColorBrush x:Key="ProgressFillBrush" Color="#FF3ABEFF" />
        <SolidColorBrush x:Key="ProgressTextBrush" Color="#CCFFFFFF" />

        <!--
            Compact transport buttons sized for the taskbar band. The hit area is
            deliberately generous relative to the glyph: they are small targets on
            a strip that the cursor crosses quickly.
        -->
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- Readability panel behind the text -->
        <Border x:Name="Backdrop"
                CornerRadius="5"
                Background="#66000000"
                BorderThickness="0" />

        <Grid Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
              Transport controls plus song progress, shown only when enabled. Each
              button is hit-testable, so a click here is handled by us rather than
              passed through to the taskbar.
            -->
            <StackPanel x:Name="TransportPanel"
                        Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Visibility="Collapsed">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PrevButton" Style="{StaticResource OverlayButton}"
                            Content="⏮" Click="OnPrevClicked" ToolTip="上一首" />
                    <Button x:Name="PlayPauseButton" Style="{StaticResource OverlayButton}"
                            Content="⏯" Click="OnPlayPauseClicked" ToolTip="暂停 / 播放" />
                    <Button x:Name="NextButton" Style="{StaticResource OverlayButton}"
                            Content="⏭" Click="OnNextClicked" ToolTip="下一首" />
                </StackPanel>

                <!-- Song progress, directly beneath the transport buttons. -->
                <Grid x:Name="ProgressSection" Margin="2,2,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Track + fill; the fill width is set from the render tick. -->
                    <Border x:Name="ProgressTrack"
                            Grid.Row="0"
                            Height="3"
                            CornerRadius="1.5"
                            Background="#40FFFFFF"
                            SizeChanged="OnProgressTrackSizeChanged">
                        <Border x:Name="ProgressFill"
                                HorizontalAlignment="Left"
                                CornerRadius="1.5"
                                Background="{StaticResource ProgressFillBrush}" />
                    </Border>

                    <TextBlock x:Name="ProgressText"
                               Grid.Row="1"
                               Margin="0,2,0,0"
                               HorizontalAlignment="Center"
                               FontSize="9"
                               Foreground="{StaticResource ProgressTextBrush}"
                               Text="--:-- / --:--" />
                </Grid>
            </StackPanel>

            <!-- Current line: karaoke sweep + translation beneath it -->
            <controls:KaraokeLine x:Name="CurrentLine"
                                  Grid.Row="0" Grid.Column="1"
                                  IsCurrent="True" />

            <!-- Upcoming line, dimmed, so the next phrase is predictable -->
            <controls:KaraokeLine x:Name="NextLine"
                                  Grid.Row="1" Grid.Column="1"
                                  IsCurrent="False"
                                  Opacity="0.75" />
        </Grid>
    </Grid>
</Window>
