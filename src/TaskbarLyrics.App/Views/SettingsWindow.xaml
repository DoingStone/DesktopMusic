<Window x:Class="TaskbarLyrics.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TaskbarLyrics.App.Controls"
        Title="任务栏歌词 · 设置"
        Width="900" Height="640"
        MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Topmost="False"
        Background="{DynamicResource WindowBg}"
        Foreground="#FF1A1A1A"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <!--
      Custom chrome so the title bar and the navigation pane read as one surface, as in
      the reference. CaptionHeight keeps the top strip draggable and double-clickable
      (snap/maximise) for free; the window buttons opt back into hit testing.
    -->
    <WindowChrome.WindowChrome>
        <!-- 32 = the caption buttons' own height, so the row's bottom edge lands exactly
             on their underside and the divider below meets them with no gap. -->
        <!-- 8 gives a comfortable grab band. The band is also enforced in code
             (HitTestHook) rather than relying on WindowChrome and DWM agreeing, which
             they do not once GlassFrameThickness makes the whole window frame. -->
        <!--
          GlassFrameThickness is 0, not -1.

          -1 means "the whole window is frame". That makes WM_NCCALCSIZE report a zero
          client area, so the entire window becomes NON-CLIENT and DWM takes over hit
          testing. WPF then never receives a client press: a press-and-move is treated as
          a caption drag (the window moves) and the caption buttons never get
          WM_LBUTTONDOWN (the close button does nothing). Neither
          WindowChrome.IsHitTestVisibleInChrome nor CaptionHeight nor an app-side
          WM_NCHITTEST answer can change that, because DWM is not the one asking.

          0 keeps a real client area, so WPF owns input. The title strip is dragged and
          the edges are resized by code in HitTestHook, which runs in the client path and
          is therefore actually consulted.
        -->
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="8"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!--
          Windows 11 Settings palette.

          These are solid colours on purpose. An earlier revision made the window
          background transparent to let a Mica backdrop show through, but Mica only
          renders when the client area has first been merged into the window frame
          via DwmExtendFrameIntoClientArea. Without that, a transparent client area
          simply paints black — which is exactly the black-on-white look this
          replaces. Solid values reproduce the same design language and cannot fail
          at runtime.
        -->
        <SolidColorBrush x:Key="Accent" Color="#FF0067C0" />
        <SolidColorBrush x:Key="Fg" Color="#FF1A1A1A" />
        <SolidColorBrush x:Key="FgMuted" Color="#FF5D5D5D" />
        <!-- Settings page group headers are plain dark text, not accent-coloured. -->
        <SolidColorBrush x:Key="FgHeading" Color="#FF1A1A1A" />
        <SolidColorBrush x:Key="Line" Color="#FFE5E5E5" />

        <!-- Card surface: solid white on the #F3F3F3 page, hairline border, 4 px radius. -->
        <SolidColorBrush x:Key="Card" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#FFE5E5E5" />
        <SolidColorBrush x:Key="ControlFill" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ControlBorder" Color="#FFD6D6D6" />
        <SolidColorBrush x:Key="ControlHover" Color="#FFF5F5F5" />

        <!--
          Mica-aware surfaces.

          These are the brush keys FluentChrome overwrites at runtime: when a Mica
          backdrop is available the window body becomes transparent and these turn
          translucent so the material shows through; when it is not, they stay opaque
          and the window looks identical to the solid design. Referenced with
          DynamicResource so the swap actually takes effect.
        -->
        <SolidColorBrush x:Key="WindowBg" Color="#FFF3F3F3" />
        <SolidColorBrush x:Key="NavBg" Color="#FFEDEDED" />
        <SolidColorBrush x:Key="ContentBg" Color="#FFF3F3F3" />
        <SolidColorBrush x:Key="NavItemFg" Color="#FF1A1A1A" />
        <SolidColorBrush x:Key="NavItemHover" Color="#14000000" />

        <!-- Tooltip surface: opaque so it reads over Mica and over content alike. -->
        <SolidColorBrush x:Key="TooltipBg" Color="#FFF9F9F9" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>


        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource FgHeading}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="12,10,12,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{DynamicResource Card}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}"
                                           Margin="{TemplateBinding Padding}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource FgHeading}" />
                                <ContentPresenter Margin="12,0,12,12" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="{DynamicResource ControlFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        </Style>

        <!--
          Fluent buttons: rounded, subtle fill, hover feedback.

          The template draws {TemplateBinding Background} rather than a hard-coded
          brush. Previously it painted ControlFill unconditionally, which silently
          discarded any Background set by a caller — that is what made the colour
          picker's swatches all render blank white.
        -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="{DynamicResource ControlFill}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHover}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFB8B8B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFEFEFEF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                CornerRadius="4"
                                Background="#FFFFFFFF"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Win11 toggle switch, as used throughout the Settings app: the label sits on
          the left and a pill-shaped switch on the right, rather than a checkbox with
          a tick. 44x20 track, 12 px knob.
        -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="0,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Margin="0,0,16,0" />

                            <Border x:Name="Track"
                                    Grid.Column="1"
                                    Width="44" Height="20"
                                    CornerRadius="10"
                                    VerticalAlignment="Center"
                                    Background="#FFFFFFFF"
                                    BorderBrush="#FF8A8A8A"
                                    BorderThickness="1">
                                <Ellipse x:Name="Knob"
                                         Width="12" Height="12"
                                         Fill="#FF5D5D5D"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Window caption buttons: glyphs only, with no persistent chrome, as the reference
          draws them. The hover fill is deliberately faint - a heavier block reads as a
          stray rectangle sitting in the corner rather than as part of the caption.
        -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0F000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Pane toggle: the same glyph-only button as the captions, but its click area is a
          disc instead of a rectangle, because it sits alone in the pane header next to the
          app identity - a faint rectangle there read as a stray box, and the reference the
          user supplied draws this button as a circle. Square box + CornerRadius = half the
          side is what makes it a true circle rather than a stadium.
        -->
        <Style x:Key="PaneToggleButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0F000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Close keeps the system's red hover, so the destructive action is unmistakable.
          The comment above this style previously claimed it did; it did not.
        -->
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent">
                            <ContentPresenter x:Name="Glyph"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C42B1C" />
                                <Setter TargetName="Glyph" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B02418" />
                                <Setter TargetName="Glyph" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Win11 tooltip: rounded, low contrast, no hard outline. The stock WPF tooltip is a
          white box with a grey border, which is what makes hovering a caption button look
          like a stray dialog.
        -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border CornerRadius="4"
                                Background="{DynamicResource TooltipBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                Padding="9,5">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Sidebar navigation item: the selected page is a filled accent pill with white
          text and a short accent bar to its left, matching the reference.
        -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <!-- Content margin, bound by the template below. It is what changes between
                 the wide pane (icon + label) and the compact rail (icon only, centred). -->
            <Setter Property="Padding" Value="13,10" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource NavItemFg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Bar"
                                    Grid.Column="0"
                                    Width="3" Height="18"
                                    CornerRadius="1.5"
                                    Background="Transparent"
                                    VerticalAlignment="Center" />

                            <Border x:Name="Pill"
                                    Grid.Column="1"
                                    Margin="3,0,8,0"
                                    CornerRadius="5"
                                    Background="Transparent">
                                <!-- Bound, not fixed: the wide pane left-aligns icon and
                                     label, the narrow rail centres a lone icon. -->
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource NavItemHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Navigation label. Foreground is bound rather than inherited: the implicit
          TextBlock style sets Foreground explicitly, which beats property inheritance
          and left the selected item's text black on the accent pill.
        -->
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
        </Style>

        <!--
          Page heading, matching the reference's large "设置" title.
        -->
        <Style x:Key="PageHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>


        <!--
          Win11 slider: a 4 px track with the sung portion filled in the accent colour
          and a 20 px circular thumb, replacing the square WPF thumb.
        -->
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="24">
                            <Border Height="4" CornerRadius="2"
                                    Background="#FFE5E5E5"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="#FFFAFAFA"
                                                             Stroke="#FF8A8A8A"
                                                             StrokeThickness="1" />
                                                    <Ellipse Fill="{DynamicResource Accent}"
                                                             Margin="6"
                                                             x:Name="Inner" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Inner" Property="Margin" Value="5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <!--
                                  The Track sizes the decrease portion to the thumb
                                  position, so painting it accent gives the Win11
                                  "filled up to the handle" look with no manual width.
                                -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="{DynamicResource Accent}"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win11 scrollbar: thin rounded thumb, no arrow buttons. -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="#59000000" Margin="2,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Win11 tabs: no boxed tab chrome. The selected tab is marked by an accent
          underline and semibold text, which is what makes the page read as Fluent
          rather than as classic WPF.
        -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Margin="2,0" />
                            <ContentPresenter x:Name="Content"
                                              ContentSource="Header"
                                              Margin="14,8"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <Border x:Name="Underline"
                                    Height="2.5"
                                    Width="18"
                                    CornerRadius="1.5"
                                    Background="{DynamicResource Accent}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,2"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFEDEDED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent tab strip: flat, no raised border around the page content. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,6,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    BorderBrush="#FFE5E5E5"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="4,0" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Matches the caption buttons' height so the divider below sits flush
                 against their underside instead of leaving a 12 px band. -->
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          Title strip, content column only.

          The navigation pane now spans the full window height, so there is no title bar
          over it. The app identity and the pane toggle moved inside the pane and are laid
          out by it, which removes the hand-computed margins that had to be resynchronised
          on every sash drag. What is left here is the drag surface and the window buttons.
        -->
        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource ContentBg}" />

        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinimiseButton" Content="&#xE921;" Click="OnMinimise"
                    Style="{StaticResource CaptionButton}" />
            <Button x:Name="MaximiseButton" Content="&#xE922;" Click="OnMaximise"
                    Style="{StaticResource CaptionButton}" />
            <Button x:Name="CloseChromeButton" Content="&#xE8BB;" Click="OnCloseWindow"
                    Style="{StaticResource CloseCaptionButton}" />
        </StackPanel>

        <!-- Spans the title strip as well, so the pane is one continuous surface from the
             top edge down and nothing has to be positioned from outside it. -->
        <Grid Grid.Row="0" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <!-- Navigation pane, as in the Windows 11 Settings reference. -->
                <ColumnDefinition x:Name="NavColumn" Width="232" MinWidth="168" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- Same height as the caption buttons so the content's divider lands on
                     their underside. -->
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
              ==================== 侧边导航 ====================
              No right border here: the sash draws the single divider. Having both drew two
              hairlines 4 px apart with the window background showing between them, which
              read as a defect. The border is restored when the pane is collapsed and the
              sash is hidden, so the rail still has an edge.
            -->
            <Border x:Name="NavPane"
                    Grid.Row="0" Grid.RowSpan="2"
                    Grid.Column="0"
                    Background="{DynamicResource NavBg}"
                    BorderThickness="0">
                <DockPanel>

                    <!--
                      Pane header. Laid out by the pane itself, so the identity sits at its
                      left edge and the toggle is pinned to its right edge at any width -
                      no margins to recompute when the sash moves.
                    -->
                    <Grid DockPanel.Dock="Top" Height="32">
                        <StackPanel x:Name="TitleIdentity"
                                    Orientation="Horizontal"
                                    Margin="18,0,0,0" VerticalAlignment="Center">
                            <Image x:Name="AppIconImage" Width="20" Height="20"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="任务栏歌词"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg}" />
                        </StackPanel>

                        <!--
                          Drawn rather than taken from an icon font: a rounded panel
                          outline with a divider at one third and the left cell tinted,
                          which is what the reference shows and a hamburger does not
                          convey.
                        -->
                        <Button x:Name="NavToggleButton"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Click="OnToggleNav"
                                Width="28" Height="28"
                                Style="{StaticResource PaneToggleButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="19" Height="15">
                                <!-- Tinted left cell, drawn first so the outline covers
                                     its corners. -->
                                <Border Width="7" HorizontalAlignment="Left"
                                        CornerRadius="3.5,0,0,3.5"
                                        Background="{DynamicResource Fg}" Opacity="0.26" />
                                <!-- Divider at one third. -->
                                <Border Width="1.2" HorizontalAlignment="Left" Margin="6.4,0,0,0"
                                        Background="{DynamicResource Fg}" />
                                <!-- Outline last, so it sits on top of both. -->
                                <Border CornerRadius="3.5"
                                        BorderThickness="1.2"
                                        BorderBrush="{DynamicResource Fg}"
                                        Background="Transparent" />
                            </Grid>
                        </Button>
                    </Grid>

                    <ListBox x:Name="NavList"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="8,10,0,12"
                             ItemContainerStyle="{StaticResource NavItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnNavSelectionChanged">

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M3,5 H15 M3,9 H15 M3,13 H15" />
                                <TextBlock x:Name="NavLabel1" Text="常规" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="18" Height="18">
                                    <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             StrokeThickness="1.5" />
                                    <Ellipse Width="5" Height="5" Margin="0,0,3,3"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Grid>
                                <TextBlock x:Name="NavLabel2" Text="外观" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M2,4 H16 V14 H2 Z M7,18 H11 M9,14 V18" />
                                <TextBlock x:Name="NavLabel3" Text="位置与显示" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="18" Height="18">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M6.5,13.5 V3.5 L14.5,2 V12" />
                                    <Ellipse Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                             Margin="2,0,0,1"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             StrokeThickness="1.5" />
                                    <Ellipse Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0,0,2,0"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             StrokeThickness="1.5" />
                                </Grid>
                                <TextBlock x:Name="NavLabel4" Text="歌词来源" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Data="M5,3 L15,9 L5,15 Z" />
                                <TextBlock x:Name="NavLabel5" Text="播放控制" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="18" Height="18">
                                    <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             StrokeThickness="1.5" />
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M9,8.2 V13 M9,5.4 V5.5" />
                                </Grid>
                                <TextBlock x:Name="NavLabel6" Text="关于" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ==================== 内容区 ==================== -->

            <!--
              Sash between the navigation pane and the content. It owns the only divider
              line, centred in a 5 px grab band, and brightens on hover so it is
              discoverable.

              IsHitTestVisibleInChrome is what keeps a press here from being treated as a
              caption drag: without it WindowChrome hands non-interactive areas to the
              window drag, which is what made the whole window move instead of the
              divider.
            -->
            <GridSplitter x:Name="NavSplitter"
                          Grid.Row="0" Grid.RowSpan="2"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="False"
                          Cursor="SizeWE"
                          Background="{DynamicResource ContentBg}"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          DragCompleted="OnNavSplitterDragCompleted">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <!--
                          The band is filled with the content colour and the line sits on
                          its left edge, exactly where the pane ends. Leaving the band
                          transparent showed 2 px of window background between the pane and
                          the line, which is the gap that read as a defect.
                        -->
                        <Border x:Name="Sash" Background="{TemplateBinding Background}">
                            <Border x:Name="SashLine"
                                    Width="1"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Line}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SashLine" Property="Width" Value="3" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="SashLine" Property="Width" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Below the content's title strip, which the root grid draws. -->
            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource ContentBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PageTitle" Grid.Row="0"
                               Style="{StaticResource PageHeading}"
                               Margin="32,26,32,0" />

                    <Border Grid.Row="1" Height="1"
                            Background="{DynamicResource Line}"
                            Margin="32,18,32,0" />

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="32,20,32,28">
                        <Grid>

                            <!-- ============ 常规 ============ -->
                            <StackPanel x:Name="PageGeneral">
                                <GroupBox Header="显示">
                                    <StackPanel>
                                        <CheckBox x:Name="VisibleCheck" Content="在任务栏显示歌词"
                                                  Click="OnOptionChanged" />
                                        <CheckBox x:Name="ShowWhenPausedCheck" Content="暂停时仍然显示"
                                                  Click="OnOptionChanged" />
                                        <CheckBox x:Name="HideWhenNoLyricsCheck" Content="找不到歌词时隐藏"
                                                  Click="OnOptionChanged" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="交互">
                                    <StackPanel>
                                        <CheckBox x:Name="InteractiveCheck"
                                                  Content="歌词可拖动 / 可点击（关闭则整条点击穿透）"
                                                  Click="OnOptionChanged" />
                                        <!-- Free position is what a vertical drag produces, so the
                                             switch and the gesture stay in step: turning it on keeps
                                             the strip where it is and lets it follow the pointer. -->
                                        <CheckBox x:Name="FreePositionCheck"
                                                  Content="脱离任务栏（自由位置，可拖到屏幕任意处）"
                                                  Click="OnOptionChanged" />
                                        <CheckBox x:Name="SnapEdgesCheck"
                                                  Content="拖动时吸附对齐（屏幕边缘、居中与任务栏行）"
                                                  Click="OnOptionChanged" />
                                        <CheckBox x:Name="PlaceAboveCheck"
                                                  Content="浮在任务栏上方（彻底消除闪烁，代价是不在任务栏内）"
                                                  Click="OnOptionChanged" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="歌词条内容">
                                    <StackPanel>
                                        <CheckBox x:Name="TransportControlsCheck"
                                                  Content="显示播放控制按钮（上一首 / 暂停 / 下一首）"
                                                  Click="OnOptionChanged" />
                                        <CheckBox x:Name="HoverRevealControlsCheck"
                                                  Content="鼠标移上去才显示控制按钮（平时只留歌词）"
                                                  Click="OnOptionChanged" />
                                        <CheckBox x:Name="SongProgressCheck"
                                                  Content="显示歌曲进度（播放按键下方）"
                                                  Click="OnOptionChanged" />

                                        <!-- These three ride the same hover reveal as the
                                             buttons: they appear together on the left while the
                                             pointer is on the strip, and the words take the
                                             whole band back once it leaves. -->
                                        <CheckBox x:Name="SongTitleCheck"
                                                  Content="鼠标移上去显示歌曲名"
                                                  Click="OnOptionChanged" />
                                        <CheckBox x:Name="SongArtistCheck"
                                                  Content="鼠标移上去显示歌手"
                                                  Click="OnOptionChanged" />
                                        <CheckBox x:Name="CoverArtCheck"
                                                  Content="鼠标移上去显示唱片封面"
                                                  Click="OnOptionChanged" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <!-- ============ 外观 ============ -->
                            <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                                <GroupBox Header="鐣岄潰澶栬">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="涓婚" Style="{StaticResource SettingLabel}" />
                                            <ComboBox x:Name="ThemeCombo" Grid.Column="1"
                                                      SelectionChanged="OnThemeChanged">
                                                <ComboBoxItem Content="跟随系统" />
                                                <ComboBoxItem Content="浅色" />
                                                <ComboBoxItem Content="深色" />
                                            </ComboBox>
                                        </Grid>
                                        <CheckBox x:Name="MicaCheck"
                                                  Content="使用云母（Mica）背景材质"
                                                  Click="OnOptionChanged" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="字体">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="字体" Style="{StaticResource SettingLabel}" />
                                        <ComboBox x:Name="FontCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                                  SelectionChanged="OnFontChanged" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="原文字号" Style="{StaticResource SettingLabel}" />
                                        <Slider x:Name="OriginalSizeSlider" Grid.Row="1" Grid.Column="1"
                                                Minimum="8" Maximum="26" TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="OnSliderChanged" />
                                        <TextBlock x:Name="OriginalSizeText" Grid.Row="1" Grid.Column="2"
                                                   Width="44" TextAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="#FF0067C0" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="译文字号" Style="{StaticResource SettingLabel}" />
                                        <Slider x:Name="TranslationSizeSlider" Grid.Row="2" Grid.Column="1"
                                                Minimum="8" Maximum="24" TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="OnSliderChanged" />
                                        <TextBlock x:Name="TranslationSizeText" Grid.Row="2" Grid.Column="2"
                                                   Width="44" TextAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="#FF0067C0" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="字重" Style="{StaticResource SettingLabel}" />
                                        <ComboBox x:Name="FontWeightCombo" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                  SelectionChanged="OnFontChanged" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="字间距" Style="{StaticResource SettingLabel}" />
                                        <Slider x:Name="LetterSpacingSlider" Grid.Row="4" Grid.Column="1"
                                                Minimum="0" Maximum="6" TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="OnSliderChanged" />
                                        <TextBlock x:Name="LetterSpacingText" Grid.Row="4" Grid.Column="2"
                                                   Width="44" TextAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="#FF0067C0" />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="颜色">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="已唱高亮" Style="{StaticResource SettingLabel}" />
                                        <controls:ColorField x:Name="HighlightColorField" Grid.Row="0" Grid.Column="1"
                                                             Margin="0,3" ColorChanged="OnColorChanged" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="未唱文字" Style="{StaticResource SettingLabel}" />
                                        <controls:ColorField x:Name="BaseColorField" Grid.Row="1" Grid.Column="1"
                                                             Margin="0,3" ColorChanged="OnColorChanged" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="下一行预览" Style="{StaticResource SettingLabel}" />
                                        <controls:ColorField x:Name="ContextColorField" Grid.Row="2" Grid.Column="1"
                                                             Margin="0,3" ColorChanged="OnColorChanged" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="背景板" Style="{StaticResource SettingLabel}" />
                                        <controls:ColorField x:Name="BackgroundColorField" Grid.Row="3" Grid.Column="1"
                                                             Margin="0,3" ColorChanged="OnColorChanged" />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="背景板与高亮">
                                    <StackPanel>
                                        <CheckBox x:Name="ShowBackgroundCheck" Content="显示背景板（提升浅色任务栏下的可读性）"
                                                  Click="OnOptionChanged" />
                                        <CheckBox x:Name="AutoAdaptColorsCheck"
                                                  Content="自动适配任务栏配色（浅色任务栏用深色字，无需背景板）"
                                                  Click="OnOptionChanged" />

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="圆角" Style="{StaticResource SettingLabel}" />
                                            <Slider x:Name="CornerSlider" Grid.Column="1"
                                                    Minimum="0" Maximum="20" TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="OnSliderChanged" />
                                            <TextBlock x:Name="CornerText" Grid.Column="2" Width="44"
                                                       TextAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="#FF0067C0" />
                                        </Grid>

                                        <CheckBox x:Name="WordHighlightCheck" Content="逐字高亮（按演唱进度推进）"
                                                  Click="OnOptionChanged" />
                                        <CheckBox x:Name="ShowTranslationCheck" Content="显示翻译行"
                                                  Click="OnOptionChanged" />
                                        <CheckBox x:Name="ShowContextCheck" Content="显示下一行预览"
                                                  Click="OnOptionChanged" />
                                        <CheckBox x:Name="LineTransitionCheck" Content="歌词换行时淡入淡出"
                                                  Click="OnOptionChanged" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <!-- ============ 位置与显示 ============ -->
                            <StackPanel x:Name="PagePosition" Visibility="Collapsed">
                                <GroupBox Header="尺寸与位置">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="宽度" Style="{StaticResource SettingLabel}" />
                                        <Slider x:Name="WidthSlider" Grid.Row="0" Grid.Column="1"
                                                Minimum="160" Maximum="1400" TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="OnSliderChanged" />
                                        <TextBlock x:Name="WidthText" Grid.Row="0" Grid.Column="2" Width="58"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="#FF0067C0" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="高度" Style="{StaticResource SettingLabel}" />
                                        <Slider x:Name="HeightSlider" Grid.Row="1" Grid.Column="1"
                                                Minimum="0" Maximum="80" TickFrequency="2"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="OnSliderChanged"
                                                ToolTip="0 = 自动适应任务栏高度" />
                                        <TextBlock x:Name="HeightText" Grid.Row="1" Grid.Column="2" Width="58"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="#FF0067C0" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="垂直对齐" Style="{StaticResource SettingLabel}" />
                                        <Slider x:Name="VerticalAlignSlider" Grid.Row="2" Grid.Column="1"
                                                Minimum="-1" Maximum="1" TickFrequency="0.1"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="OnSliderChanged"
                                                ToolTip="相对任务栏高度上下微调" />
                                        <TextBlock x:Name="VerticalAlignText" Grid.Row="2" Grid.Column="2" Width="58"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="#FF0067C0" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="水平偏移" Style="{StaticResource SettingLabel}" />
                                        <!--
                                          Range deliberately wider than any real screen so a
                                          long drag is never clamped by the slider and then
                                          written back as a smaller value on the next edit.
                                        -->
                                        <Slider x:Name="OffsetXSlider" Grid.Row="3" Grid.Column="1"
                                                Minimum="-4000" Maximum="4000" TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="OnSliderChanged" />
                                        <TextBlock x:Name="OffsetXText" Grid.Row="3" Grid.Column="2" Width="58"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="#FF0067C0" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="垂直偏移" Style="{StaticResource SettingLabel}" />
                                        <Slider x:Name="OffsetYSlider" Grid.Row="4" Grid.Column="1"
                                                Minimum="-200" Maximum="200" TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="OnSliderChanged" />
                                        <TextBlock x:Name="OffsetYText" Grid.Row="4" Grid.Column="2" Width="58"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="#FF0067C0" />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="透明度">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="整体不透明度" Style="{StaticResource SettingLabel}" />
                                        <Slider x:Name="OpacitySlider" Grid.Column="1"
                                                Minimum="0.15" Maximum="1" TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="OnSliderChanged" />
                                        <TextBlock x:Name="OpacityText" Grid.Column="2" Width="58"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="#FF0067C0" />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="歌词同步微调">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="偏移（毫秒）" Style="{StaticResource SettingLabel}" />
                                        <Slider x:Name="OffsetSlider" Grid.Column="1"
                                                Minimum="-5000" Maximum="5000" TickFrequency="50"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="OnSliderChanged" />
                                        <TextBlock x:Name="OffsetText" Grid.Column="2" Width="70"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="#FF0067C0" />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="微调位置">
                                    <StackPanel>
                                        <TextBlock Text="歌词条可直接用鼠标拖动（需在「常规」中开启「歌词可拖动」）：左右拖动贴着任务栏移动，向下拖出任务栏即变成自由位置的悬浮条，可放在屏幕任意处，松手时自动吸附。"
                                                   Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                   Margin="0,0,0,10" TextWrapping="Wrap" />
                                        <UniformGrid Columns="4">
                                            <Button Content="← 左移" Click="OnMoveLeft" />
                                            <Button Content="右移 →" Click="OnMoveRight" />
                                            <Button Content="↑ 上移" Click="OnMoveUp" />
                                            <Button Content="↓ 下移" Click="OnMoveDown" />
                                        </UniformGrid>
                                        <Button Content="恢复默认位置与宽度" Click="OnResetPosition"
                                                Margin="0,10,0,0" HorizontalAlignment="Left" />
                                        <Button Content="吸附回任务栏" Click="OnDockToTaskbar"
                                                Margin="0,6,0,0" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <!-- ============ 歌词来源 ============ -->
                            <StackPanel x:Name="PageLyrics" Visibility="Collapsed">
                                <GroupBox Header="在线歌词来源">
                                    <StackPanel>
                                        <TextBlock Text="多个来源会并发检索，再按标题、歌手、时长打分择优。"
                                                   Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <!-- Word timing first: it is the only source that can
                                             follow the singing rather than the line. -->
                                        <CheckBox x:Name="WordLyricsCheck"
                                                  Content="逐字时间轴（AMLL 社区库，高亮跟随每个字）"
                                                  Click="OnProviderChanged" />
                                        <CheckBox x:Name="QqMusicCheck" Content="QQ音乐（中文曲库最全）"
                                                  Click="OnProviderChanged" />
                                        <CheckBox x:Name="NetEaseCheck" Content="网易云音乐（补充曲库与翻译）"
                                                  Click="OnProviderChanged" />
                                        <CheckBox x:Name="LrclibCheck" Content="LRCLIB（欧美曲库，开放数据库）"
                                                  Click="OnProviderChanged" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="缓存与匹配">
                                    <StackPanel>
                                        <TextBlock Text="换歌后歌词不正确时，可先「重新匹配」；仍不对则清空缓存再试。"
                                                   Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="重新匹配当前歌曲" Click="OnRematch" Margin="0" />
                                            <Button Content="清空歌词缓存" Click="OnClearCache" />
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="诊断">
                                    <StackPanel>
                                        <TextBlock Text="用于排查问题：显示当前曲目、各歌词源命中与歌词匹配结果。"
                                                   Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <Button Content="查看当前歌词匹配详情" Click="OnShowDiagnostics"
                                                HorizontalAlignment="Left" Margin="0" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <!-- ============ 播放控制 ============ -->
                            <StackPanel x:Name="PagePlayback" Visibility="Collapsed">
                                <GroupBox Header="立即控制当前播放器">
                                    <StackPanel>
                                        <TextBlock Text="命令会发送给正在为歌词提供播放信息的那个播放器。若播放器未开放相应控件，按钮会提示不支持。"
                                                   Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <UniformGrid Columns="3">
                                            <Button Content="⏮  上一首" Click="OnTransportPrevious" />
                                            <Button Content="⏯  暂停/播放" Click="OnTransportPlayPause" />
                                            <Button Content="⏭  下一首" Click="OnTransportNext" />
                                        </UniformGrid>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="全局快捷键">
                                    <StackPanel>
                                        <TextBlock Text="快捷键在系统范围内生效，因此不必让歌词框接收鼠标点击。留空即可关闭某一项。格式示例：Ctrl+Alt+Space、Ctrl+Alt+Right。"
                                                   Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="暂停 / 播放" Style="{StaticResource SettingLabel}" />
                                            <TextBox x:Name="HotkeyPlayPauseBox" Grid.Row="0" Grid.Column="1"
                                                     Margin="0,3" TextChanged="OnHotkeyTextChanged" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="下一首" Style="{StaticResource SettingLabel}" />
                                            <TextBox x:Name="HotkeyNextBox" Grid.Row="1" Grid.Column="1"
                                                     Margin="0,3" TextChanged="OnHotkeyTextChanged" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="上一首" Style="{StaticResource SettingLabel}" />
                                            <TextBox x:Name="HotkeyPreviousBox" Grid.Row="2" Grid.Column="1"
                                                     Margin="0,3" TextChanged="OnHotkeyTextChanged" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="显示 / 隐藏歌词" Style="{StaticResource SettingLabel}" />
                                            <TextBox x:Name="HotkeyToggleBox" Grid.Row="3" Grid.Column="1"
                                                     Margin="0,3" TextChanged="OnHotkeyTextChanged" />
                                        </Grid>

                                        <TextBlock x:Name="HotkeyStatusText"
                                                   Foreground="#FF0067C0" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="拖动说明">
                                    <TextBlock Text="在「常规」中开启「歌词可拖动」后，即可直接用鼠标拖动歌词框：左右拖动贴着任务栏滑动，拖出任务栏就变成可放在屏幕任意处的悬浮条，拖回任务栏会自动重新贴合。松手时吸附到屏幕边缘、居中线与任务栏行。位置会自动保存；关闭「歌词可拖动」后恢复点击穿透，不会挡住任务栏操作（此时鼠标移开仍会隐藏按钮并把歌词移回正中）。"
                                               Foreground="{DynamicResource FgMuted}" FontSize="11" TextWrapping="Wrap" />
                                </GroupBox>
                            </StackPanel>

                            <!-- ============ 关于 ============ -->
                            <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                                <GroupBox Header="关于本程序">
                                    <StackPanel>
                                        <TextBlock x:Name="AboutVersionText"
                                                   Foreground="{DynamicResource Fg}" FontWeight="SemiBold"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="在 Windows 任务栏的空白区域显示当前播放歌曲的歌词，支持逐字高亮、翻译、歌曲进度与播放控制。"
                                                   Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="链接">
                                    <StackPanel>
                                        <TextBlock Text="项目主页与问题反馈" Foreground="{DynamicResource Fg}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock x:Name="AboutRepoText" Foreground="#FF0067C0"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <TextBlock Text="许可证：MIT" Foreground="{DynamicResource FgMuted}" FontSize="11" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="配置文件">
                                    <StackPanel>
                                        <TextBlock Text="修改后点「保存」写入下面的文件；「关闭」会恢复打开设置前的状态。"
                                                   Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock x:Name="ConfigPathText"
                                                   Foreground="#FF0067C0" FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 底部操作栏 ==================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource ContentBg}"
                BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,12,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="ResetButton" Content="恢复默认设置"
                        Click="OnRestoreDefaults" Margin="0" MinWidth="120" />

                <TextBlock x:Name="StatusText" Grid.Column="1"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#FF1E874B" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="QuitButton" Content="退出程序"
                            Click="OnQuit"
                            ToolTip="关闭任务栏歌词并退出" />
                    <Button x:Name="CloseButton" Content="关闭"
                            Click="OnCloseWindow"
                            IsCancel="True"
                            ToolTip="收起本窗口，歌词继续显示（设置已保存）" />
                    <Button x:Name="SaveButton" Content="保存"
                            Click="OnSave"
                            IsDefault="True"
                            ToolTip="保存设置但不关闭窗口" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
