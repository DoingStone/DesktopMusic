<UserControl x:Class="TaskbarLyrics.App.Controls.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="26">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Clicking anywhere on the swatch/hex area opens the picker -->
        <Button x:Name="SwatchButton"
                Grid.Column="0"
                Click="OnOpenPicker"
                Cursor="Hand"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
            <Border CornerRadius="3"
                    BorderBrush="#FFC9D0DA"
                    BorderThickness="1"
                    Background="#FFFFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Opaque checker so alpha colours read correctly -->
                    <Border Grid.Column="0"
                            CornerRadius="2,0,0,2"
                            Background="#FFFFFFFF">
                        <Border x:Name="Swatch" CornerRadius="2,0,0,2" />
                    </Border>

                    <TextBlock x:Name="HexText"
                               Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="#FF1F2430" />
                </Grid>
            </Border>
        </Button>

        <Popup x:Name="Picker"
               Grid.Column="0"
               PlacementTarget="{Binding ElementName=SwatchButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="#FF2B2B2B"
                    BorderBrush="#FF555555"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,4,0,0">
                <StackPanel Width="252">
                    <TextBlock Text="常用颜色" Foreground="#FFAAAAAA" FontSize="11" Margin="0,0,0,6" />

                    <UniformGrid x:Name="SwatchGrid" Columns="8" Rows="3" />

                    <TextBlock Text="自定义（支持 #AARRGGBB 或 #RRGGBB）"
                               Foreground="#FFAAAAAA" FontSize="11" Margin="0,10,0,4" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HexInput"
                                 Grid.Column="0"
                                 FontFamily="Consolas"
                                 KeyDown="OnHexKeyDown" />
                        <Button x:Name="ApplyHexButton"
                                Grid.Column="1"
                                Content="确定"
                                Margin="6,0,0,0"
                                Padding="12,2"
                                Click="OnApplyHex" />
                    </Grid>

                    <TextBlock x:Name="ErrorText"
                               Foreground="#FFFF8080"
                               FontSize="11"
                               Margin="0,6,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
